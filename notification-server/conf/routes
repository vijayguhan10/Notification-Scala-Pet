# Routes
# This file defines all application routes (Higher priority routes first)
# https://www.playframework.com/documentation/latest/ScalaRouting
# ~~~~

# An example controller showing a sample home page
GET     /                           controllers.HomeController.index()

# Event streaming (Kafka publishing)
POST    /api/events                  controllers.EventStreamController.start()
POST    /api/events/stop/:streamId   controllers.EventStreamController.stop(streamId: String)
GET     /api/events/status/:streamId controllers.EventStreamController.status(streamId: String)
GET     /api/events/ws               controllers.EventStreamController.ws()

# Traffic analytics (historical)
GET     /api/analytics/traffic       controllers.EventStreamController.trafficAnalytics()

# Notifications
GET     /api/notifications                   controllers.NotificationController.list()
GET     /api/notifications/:id               controllers.NotificationController.get(id: Long)
PUT     /api/notifications/:id/status        controllers.NotificationController.updateStatus(id: Long)

# Event Metadata Endpoints
POST    /api/location_type/events                  controllers.Parking_Map.EventMetadataController.create()
GET     /api/location_type/events/active           controllers.Parking_Map.EventMetadataController.getActiveByLocation(locationId: String)
GET     /api/location_type/events/:id              controllers.Parking_Map.EventMetadataController.getById(id: Int)
GET     /api/location_type/events                  controllers.Parking_Map.EventMetadataController.list(limit: Int ?= 50, offset: Int ?= 0)
DELETE  /api/location_type/events/:id              controllers.Parking_Map.EventMetadataController.delete(id: Int)

# Map static resources from the /public folder to the /assets URL path
GET     /assets/*file               controllers.Assets.versioned(path="/public", file: Asset)
